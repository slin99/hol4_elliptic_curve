Theorem bn254_g2_full_generator_scalar_tests:
  bn254_g2_group.exp bn254_g2_full_generator bn254_g2_full_order = ECInfinity /\
  bn254_g2_group.exp bn254_g2_full_generator (bn254_g2_full_order DIV 10069) <> ECInfinity /\
  bn254_g2_group.exp bn254_g2_full_generator (bn254_g2_full_order DIV 5864401) <> ECInfinity /\
  bn254_g2_group.exp bn254_g2_full_generator (bn254_g2_full_order DIV 1875725156269) <> ECInfinity /\
  bn254_g2_group.exp bn254_g2_full_generator
    (bn254_g2_full_order DIV 197620364512881247228717050342013327560683201906968909) <> ECInfinity /\
  bn254_g2_group.exp bn254_g2_full_generator (bn254_g2_full_order DIV bn254_n) <> ECInfinity
Proof
  ACCEPT_TAC (LIST_CONJ
    [bn254_g2_full_generator_annihilated,
     bn254_g2_full_generator_div_10069_nonzero,
     bn254_g2_full_generator_div_5864401_nonzero,
     bn254_g2_full_generator_div_1875725156269_nonzero,
     bn254_g2_full_generator_div_cofactor_prime_nonzero,
     bn254_g2_full_generator_div_n_nonzero])
QED

Theorem bn254_g2_full_order_prime_divisors:
  prime q /\ q divides bn254_g2_full_order ==>
  q = bn254_n \/ q = 10069 \/ q = 5864401 \/ q = 1875725156269 \/
  q = 197620364512881247228717050342013327560683201906968909
Proof
  strip_tac >>
  qpat_assum `prime q` (fn p =>
    FULL_SIMP_TAC bool_ss
      [bn254_g2_full_order_def, bn254_g2_full_cofactor_factorization,
       MATCH_MP prime_certificate_divides_product p]) >>
  metis_tac[prime_divides_only_self, bn254_g2_cofactor_primes, bn254_n_prime]
QED

Theorem bn254_g2_full_generator_order:
  order bn254_g2_group bn254_g2_full_generator = bn254_g2_full_order
Proof
  rw[bn254_g2_group_def] >>
  `0 < bn254_g2_full_order` by EVAL_TAC >>
  irule sw_exact_order_certificate >>
  simp[bn254_g2_curve, bn254_g2_full_generator_member] >>
  metis_tac[bn254_g2_full_order_prime_divisors,
    REWRITE_RULE [bn254_g2_group_def] bn254_g2_full_generator_scalar_tests]
QED

