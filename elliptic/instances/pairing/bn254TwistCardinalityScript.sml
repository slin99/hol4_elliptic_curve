Theorem bn254_g2_cardinality_field[local]:
  Field bn254_fp2
Proof
  metis_tac[bn254_fp2_finite_field, FiniteField_def]
QED

Theorem bn254_g2_full_generator_member:
  bn254_g2_full_generator IN sw_points bn254_fp2 bn254_g2_a bn254_g2_b
Proof
  let
    val defs = [bn254_fp2_def, bn254_fp2_poly_def, bn254_p_def,
      bn254_g2_a_def, bn254_g2_b_def, bn254_g2_full_generator_def,
      sw_points_member, sw_on_curve_def, sw_curve_rhs_def]
    val prime = REWRITE_RULE defs bn254_p_prime
    val field = REWRITE_RULE defs bn254_g2_cardinality_field
  in CONV_TAC (REWRITE_CONV defs THENC
       pairingCurveCertificateLib.FIELD_CONV prime field) end
QED

val cardinality_definitions =
  [bn254_g2_group_def, bn254_fp2_def, bn254_fp2_poly_def,
   bn254_p_def, bn254_n_def, bn254_g2_a_def, bn254_g2_b_def,
   bn254_g2_full_generator_def, bn254_g2_full_order_def,
   bn254_g2_full_cofactor_def];
fun cardinality_numeric th =
  CONV_RULE certificateComputeLib.NAT_CONV
    (REWRITE_RULE cardinality_definitions th);
val cardinality_prime = cardinality_numeric bn254_p_prime;
val cardinality_field = cardinality_numeric bn254_g2_cardinality_field;
val cardinality_curve = cardinality_numeric bn254_g2_curve;
val cardinality_member = cardinality_numeric bn254_g2_full_generator_member;
(* Goal normalization stays source-visible below; each timed certificate
   branch only proposes milestones, using these immutable numeric premises. *)
fun cardinality_scalar_tac goal =
  pairingCurveCertificateLib.SCALAR_CERTIFICATE_TAC
    cardinality_prime cardinality_field cardinality_curve
    cardinality_member goal;

fun cardinality_scalar_step_tac goal =
  pairingCurveCertificateLib.SCALAR_STEP_TAC
    cardinality_prime cardinality_field cardinality_curve
    cardinality_member goal;

