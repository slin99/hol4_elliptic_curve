Theorem bn254_g2_a_zero[local]:
  bn254_g2_a = bn254_fp2.sum.id
Proof
  REWRITE_TAC cardinality_definitions >>
  CONV_TAC (pairingCurveCertificateLib.FIELD_CONV
    cardinality_prime cardinality_field)
QED

Theorem bn254_g2_no_two_torsion:
  !P. P IN sw_points bn254_fp2 bn254_g2_a bn254_g2_b /\
      bn254_g2_group.exp P 2 = ECInfinity ==> P = ECInfinity
Proof
  REWRITE_TAC [bn254_g2_group_def] >>
  rpt strip_tac >> irule sw_root_free_no_two_torsion >>
  qexistsl_tac [`bn254_g2_a`, `bn254_g2_b`, `bn254_fp2`] >>
  simp[bn254_g2_curve] >>
  rpt strip_tac >>
  `Field bn254_fp2 /\ bn254_g2_b IN bn254_fp2.carrier` by
    metis_tac[bn254_g2_curve, ShortWeierstrassCurve_def] >>
  `!z. z IN bn254_fp2.carrier ==>
       bn254_fp2.prod.exp z 3 <> bn254_fp2.sum.inv bn254_g2_b` by
    (gen_tac >> disch_tac >>
     irule (ISPECL [``bn254_fp2``, ``bn254_fp2.sum.inv bn254_g2_b``,
       ``(bn254_p ** 2 - 1) DIV 3``] finite_field_cube_nonresidue) >>
     simp[bn254_fp2_finite_field, field_neg_element, field_neg_eq_zero,
          bn254_g2_noncube_certificate, bn254_fp2_card] >>
     CONV_TAC (certificateComputeLib.EVAL_CONV ())) >>
  qpat_x_assum `sw_curve_rhs bn254_fp2 bn254_g2_a bn254_g2_b x = _`
    mp_tac >>
  ASM_SIMP_TAC bool_ss
    [sw_curve_rhs_def, bn254_g2_a_zero, bn254_g2_cardinality_field,
     field_mult_lzero, field_add_rzero, field_exp_element, field_add_eq_zero] >>
  strip_tac >>
  qpat_x_assum `!z. _` (qspec_then `x` mp_tac) >>
  ASM_SIMP_TAC bool_ss
    [bn254_g2_cardinality_field, field_exp_element, field_neg_neg]
QED

Theorem bn254_g2_cardinality:
  CARD (sw_points bn254_fp2 bn254_g2_a bn254_g2_b) = bn254_g2_full_order
Proof
  irule (Q.INST [`P` |-> `bn254_g2_full_generator`]
    (INST_TYPE [``:'a`` |-> ``:num list``]
      sw_cardinality_from_odd_point_order)) >>
  simp[bn254_g2_curve, bn254_fp2_finite_field,
       REWRITE_RULE [bn254_g2_group_def] bn254_g2_full_generator_order,
       bn254_g2_full_generator_member,
       REWRITE_RULE [bn254_g2_group_def] bn254_g2_no_two_torsion,
       bn254_fp2_card] >> CONV_TAC (certificateComputeLib.EVAL_CONV ())
QED

Theorem bn254_g2_group_cardinality:
  CARD bn254_g2_group.carrier = bn254_g2_full_order
Proof
  simp[bn254_g2_group_def, bn254_g2_cardinality]
QED

Theorem bn254_g2_full_cofactor_relation:
  CARD bn254_g2_group.carrier = bn254_g2_full_cofactor * bn254_n /\
  bn254_g2_full_cofactor = 2 * bn254_p - bn254_n
Proof
  SIMP_TAC bool_ss
    [bn254_g2_group_cardinality, bn254_g2_full_order_def,
     bn254_g2_full_cofactor_def, MULT_COMM]
QED

Theorem bn254_g2_prime_subgroup_is_proper:
  CARD bn254_g2_subgroup.carrier = bn254_n /\
  CARD bn254_g2_subgroup.carrier < CARD bn254_g2_group.carrier /\
  bn254_g2_subgroup.carrier <> bn254_g2_group.carrier
Proof
  SIMP_TAC bool_ss [bn254_g2_subgroup_card, bn254_g2_group_cardinality] >>
  `bn254_n < bn254_g2_full_order` by
    CONV_TAC (certificateComputeLib.EVAL_CONV ()) >>
  metis_tac[bn254_g2_subgroup_card, bn254_g2_group_cardinality,
            prim_recTheory.LESS_REFL]
QED

Theorem bn254_g2_cofactor_clearing:
  P IN sw_points bn254_fp2 bn254_g2_a bn254_g2_b ==>
  bn254_g2_group.exp P bn254_g2_full_cofactor IN
    (sw_torsion_group bn254_fp2 bn254_g2_a bn254_g2_b bn254_n).carrier
Proof
  strip_tac >> rw[bn254_g2_group_def] >>
  irule sw_cofactor_clearing >>
  simp[bn254_fp2_finite_field, bn254_g2_curve, bn254_g2_cardinality,
       bn254_g2_full_order_def, MULT_COMM]
QED

Theorem bn254_g2_full_generator_cofactor_order:
  order bn254_g2_group
    (bn254_g2_group.exp bn254_g2_full_generator bn254_g2_full_cofactor) = bn254_n
Proof
  rw[bn254_g2_group_def] >> irule sw_cofactor_clearing_order >>
  simp[bn254_g2_curve, bn254_g2_full_generator_member,
       REWRITE_RULE [bn254_g2_group_def] bn254_g2_full_generator_order,
       bn254_g2_full_order_def, MULT_COMM] >> EVAL_TAC
QED

