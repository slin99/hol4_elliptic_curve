Theorem bls12381_g2_torsion_cubic_roots:
  prime q /\ q divides bls12381_g2_torsion_factor /\
  t < q /\ t ** 3 MOD q = 1 ==>
  (q = 13 /\ (t = 1 \/ t = 3 \/ t = 9)) \/ (q = 23 /\ t = 1)
