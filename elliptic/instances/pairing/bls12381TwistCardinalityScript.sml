  strip_tac >>
  `q divides
    (13 * 23 * 2713 * 11953 * 262069 * bls12381_g2_cofactor_prime * bls12381_n)` by
    metis_tac[bls12381_g2_full_cofactor_factorization] >>
  qpat_assum `prime q` (fn p =>
    FULL_SIMP_TAC bool_ss [MATCH_MP prime_certificate_divides_product p]) >>
  metis_tac[prime_divides_only_self, bls12381_g2_cofactor_primes,
            bls12381_n_prime]
QED

