  Field bls12381_fp2
Proof
  metis_tac[bls12381_fp2_finite_field, FiniteField_def]
QED

val cardinality_definitions =
  [bls12381_g2_group_def, bls12381_fp2_def, bls12381_fp2_poly_def,
   bls12381_p_def, bls12381_n_def, bls12381_g2_a_def, bls12381_g2_b_def,
   bls12381_g2_large_point_def, bls12381_g2_large_order_def,
   bls12381_g2_torsion_factor_def, bls12381_g2_full_cofactor_def,
   bls12381_g2_cofactor_prime_def, bls12381_g2_cm_beta_def,
   bls12381_g2_cm13_point_def, bls12381_g2_cm23_point_def];
fun cardinality_numeric th =
  CONV_RULE certificateComputeLib.NAT_CONV
    (REWRITE_RULE cardinality_definitions th);
val cardinality_prime = cardinality_numeric bls12381_p_prime;
val cardinality_field = cardinality_numeric bls12381_g2_cardinality_field;
val cardinality_curve = cardinality_numeric bls12381_g2_curve;
val cardinality_field_conv =
  pairingCurveCertificateLib.FIELD_CONV cardinality_prime cardinality_field;
val cardinality_field_tac =
  CONV_TAC (REWRITE_CONV cardinality_definitions THENC
    certificateComputeLib.NAT_CONV THENC cardinality_field_conv);

Theorem bls12381_g2_zero_coefficient:
  bls12381_g2_a = bls12381_fp2.sum.id
Proof
  cardinality_field_tac
QED

Theorem bls12381_g2_large_point_member:
  bls12381_g2_large_point IN
    sw_points bls12381_fp2 bls12381_g2_a bls12381_g2_b
Proof
  REWRITE_TAC [bls12381_g2_large_point_def,
               sw_points_member, sw_on_curve_def, sw_curve_rhs_def] >>
  cardinality_field_tac
QED

val cardinality_member = cardinality_numeric bls12381_g2_large_point_member;
(* Goal normalization stays source-visible below; each timed certificate
   branch only proposes milestones, using these immutable numeric premises. *)

fun cardinality_scalar_tac goal =
  pairingCurveCertificateLib.SCALAR_CERTIFICATE_TAC
    cardinality_prime cardinality_field cardinality_curve
    cardinality_member goal;

fun cardinality_scalar_step_tac goal =
  pairingCurveCertificateLib.SCALAR_STEP_TAC
    cardinality_prime cardinality_field cardinality_curve
    cardinality_member goal;

fun cardinality_finish_tac goal =
  (CONV_TAC (REWRITE_CONV [sw_cm_map_def] THENC cardinality_field_conv) >>
   EVAL_TAC) goal;

